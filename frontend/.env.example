# Used by next.config.ts rewrites (server-side only)
BACKEND_URL=http://localhost:8000
# Only needed with STORAGE_BACKEND=supabase on the backend (for uploadToSignedUrl)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_BUCKET=brochures
# Show the demo credentials hint on the login page ("true"/"false")
NEXT_PUBLIC_SHOW_DEMO_HINT=true
NEXT_PUBLIC_DEMO_EMAIL=demo@hyundai-assistant.app
NEXT_PUBLIC_DEMO_PASSWORD=Demo1234
