APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hyundai
# Supabase (Session Pooler, port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me-to-64-random-chars
JWT_EXPIRES_MINUTES=720
COOKIE_SECURE=false
COOKIE_NAME=hyundai_session
FRONTEND_ORIGIN=http://localhost:3000
ALLOW_REGISTRATION=true

# local = files saved to ./uploads (no Supabase needed); supabase = Supabase Storage signed uploads
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=brochures
MAX_UPLOAD_MB=50

# gemini | openai | fake (fake = offline deterministic provider for tests/demos without keys)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_PLANNER_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIM=768

VISION_OCR_FALLBACK=true
RETRIEVAL_TOP_K=8
LLM_QUERY_PLANNER=true
